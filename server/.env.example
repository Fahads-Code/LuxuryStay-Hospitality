# LuxuryStay HMS — server configuration
# Copy this file to `server/.env` and adjust as needed.

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=dev

# MongoDB
# Leave MONGODB_URI empty to try mongodb://127.0.0.1:27017/luxurystay.
# If that is unavailable and USE_MEMORY_DB=true, an in-memory MongoDB is
# started automatically (data disappears when the process exits).
MONGODB_URI=mongodb://127.0.0.1:27017/luxurystay
USE_MEMORY_DB=true

# Authentication — use a long, random value in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Browser origin allowed by CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# First start: open the app and create the administrator account.
# To wipe all data and return to the setup screen, run:
#   npm run reset -- --yes

